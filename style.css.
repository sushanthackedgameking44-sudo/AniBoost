@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

:root {
  --bg: #050816;
  --bg2: #080d1f;
  --card: rgba(12, 18, 38, 0.78);
  --card-hover: rgba(18, 26, 52, 0.9);
  --border: rgba(130, 150, 210, 0.16);
  --text: #f4f7ff;
  --muted: #8d98b5;
  --blue: #4f8cff;
  --purple: #8b5cf6;
  --cyan: #22d3ee;
  --shadow: rgba(0, 0, 0, 0.35);
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: "Inter", Arial, sans-serif;
  color: var(--text);
  background:
    radial-gradient(
      circle at 15% 10%,
      rgba(79, 140, 255, 0.15),
      transparent 28%
    ),
    radial-gradient(
      circle at 85% 20%,
      rgba(139, 92, 246, 0.14),
      transparent 30%
    ),
    radial-gradient(
      circle at 50% 90%,
      rgba(34, 211, 238, 0.08),
      transparent 30%
    ),
    linear-gradient(135deg, var(--bg), var(--bg2));

  min-height: 100vh;
  overflow-x: hidden;
}

/* Subtle futuristic grid */

body::before {
  content: "";
  position: fixed;
  inset: 0;

  background-image:
    linear-gradient(
      rgba(255, 255, 255, 0.025) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(255, 255, 255, 0.025) 1px,
      transparent 1px
    );

  background-size: 45px 45px;

  mask-image: linear-gradient(
    to bottom,
    black,
    transparent 85%
  );

  pointer-events: none;
  z-index: -2;
}

/* Ambient glow */

body::after {
  content: "";
  position: fixed;

  width: 500px;
  height: 500px;

  top: 25%;
  left: 50%;

  transform: translate(-50%, -50%);

  background: rgba(79, 140, 255, 0.08);

  filter: blur(120px);

  border-radius: 50%;

  pointer-events: none;

  z-index: -3;
}

a {
  color: inherit;
  text-decoration: none;
}

button,
input,
select {
  font: inherit;
}

/* =========================
   NAVBAR
========================= */

.navbar {
  width: min(1150px, 92%);
  height: 76px;

  margin: auto;

  display: flex;
  align-items: center;
  justify-content: space-between;

  border-bottom: 1px solid var(--border);
}

.logo {
  font-size: 22px;
  font-weight: 800;
  letter-spacing: -1px;
}

.logo span:last-child {
  background: linear-gradient(
    90deg,
    var(--blue),
    var(--purple)
  );

  -webkit-background-clip: text;
  color: transparent;
}

.logo-icon {
  color: var(--cyan);
  margin-right: 5px;
}

nav {
  display: flex;
  gap: 32px;

  color: var(--muted);

  font-size: 14px;
}

nav a {
  transition: 0.2s;
}

nav a:hover {
  color: white;
}

.icon-btn {
  border: 1px solid var(--border);

  background: rgba(15, 22, 43, 0.7);

  color: white;

  border-radius: 10px;

  padding: 9px 11px;

  cursor: pointer;
}

/* =========================
   HERO
========================= */

.hero {
  width: min(920px, 92%);

  margin: auto;

  text-align: center;

  padding: 110px 0 90px;
}

.badge {
  display: inline-block;

  padding: 8px 15px;

  border: 1px solid rgba(79, 140, 255, 0.25);

  background: rgba(79, 140, 255, 0.08);

  border-radius: 999px;

  color: #9ec2ff;

  font-size: 12px;

  font-weight: 700;

  margin-bottom: 25px;

  box-shadow:
    0 0 25px rgba(79, 140, 255, 0.08);
}

.hero h1 {
  font-size: clamp(43px, 7vw, 78px);

  line-height: 1.04;

  letter-spacing: -4px;
}

.hero h1 span {
  background:
    linear-gradient(
      90deg,
      #60a5fa,
      #8b5cf6,
      #22d3ee
    );

  -webkit-background-clip: text;

  color: transparent;
}

.hero-text {
  max-width: 650px;

  margin: 25px auto;

  color: var(--muted);

  font-size: 17px;
}

.hero-btn {
  display: inline-block;

  background:
    linear-gradient(
      135deg,
      #4f8cff,
      #7c3aed
    );

  padding: 14px 27px;

  border-radius: 12px;

  font-weight: 700;

  box-shadow:
    0 10px 35px rgba(79, 140, 255, 0.22);

  transition: 0.25s;
}

.hero-btn:hover {
  transform: translateY(-3px);

  box-shadow:
    0 18px 45px rgba(79, 140, 255, 0.32);
}

.hero-stats {
  margin: 55px auto 0;

  display: flex;

  justify-content: center;

  gap: 70px;
}

.hero-stats div {
  display: flex;

  flex-direction: column;
}

.hero-stats strong {
  font-size: 24px;
}

.hero-stats small {
  color: #68738f;

  font-size: 12px;
}

/* =========================
   SECTIONS
========================= */

.generator-section,
.results,
.features-section,
.about-section {
  width: min(1100px, 92%);

  margin: auto;

  padding: 85px 0;
}

.section-heading {
  text-align: center;

  margin-bottom: 35px;
}

.section-heading span,
.about-card span {
  font-size: 11px;

  font-weight: 800;

  letter-spacing: 2px;

  color: #6ea8ff;
}

.section-heading h2 {
  font-size: clamp(28px, 5vw, 42px);

  margin: 8px 0;
}

.section-heading p {
  color: var(--muted);
}

/* =========================
   GLASS CARDS
========================= */

.generator-card,
.result-card,
.feature,
.about-card {
  border: 1px solid var(--border);

  background:
    linear-gradient(
      145deg,
      rgba(16, 24, 49, 0.86),
      rgba(8, 13, 29, 0.78)
    );

  border-radius: 18px;

  backdrop-filter: blur(18px);

  box-shadow:
    0 20px 60px var(--shadow);
}

.generator-card {
  padding: 30px;

  max-width: 900px;

  margin: auto;
}

/* =========================
   FORM
========================= */

.form-grid {
  display: grid;

  grid-template-columns: 1fr 1fr;

  gap: 20px;
}

.input-group label {
  display: block;

  font-size: 13px;

  font-weight: 600;

  margin-bottom: 8px;

  color: #b9c4dc;
}

input,
select {
  width: 100%;

  padding: 14px;

  border: 1px solid rgba(130, 150, 210, 0.18);

  border-radius: 11px;

  outline: none;

  background: rgba(5, 9, 22, 0.75);

  color: white;

  transition: 0.2s;
}

input::placeholder {
  color: #59647e;
}

input:focus,
select:focus {
  border-color: var(--blue);

  box-shadow:
    0 0 0 3px rgba(79, 140, 255, 0.12),
    0 0 25px rgba(79, 140, 255, 0.08);
}

.generate-btn {
  width: 100%;

  margin-top: 24px;

  border: none;

  border-radius: 12px;

  padding: 15px;

  color: white;

  background:
    linear-gradient(
      135deg,
      #4f8cff,
      #7c3aed
    );

  font-weight: 800;

  cursor: pointer;

  transition: 0.25s;

  box-shadow:
    0 10px 30px rgba(79, 140, 255, 0.2);
}

.generate-btn:hover {
  transform: translateY(-2px);

  box-shadow:
    0 16px 40px rgba(79, 140, 255, 0.3);
}

.privacy-note {
  text-align: center;

  color: #59647e;

  font-size: 11px;

  margin-top: 12px;
}

.error {
  color: #fb7185;

  text-align: center;

  margin-top: 15px;
}

.hidden {
  display: none;
}

/* =========================
   RESULTS
========================= */

.results-grid {
  display: grid;

  grid-template-columns: 1fr 1fr;

  gap: 18px;
}

.result-card {
  padding: 22px;

  transition: 0.25s;
}

.result-card:hover {
  transform: translateY(-3px);

  border-color: rgba(79, 140, 255, 0.28);
}

.result-card.wide {
  grid-column: span 2;
}

.result-header {
  display: flex;

  align-items: center;

  justify-content: space-between;

  margin-bottom: 17px;
}

.result-header div {
  display: flex;

  align-items: center;

  gap: 9px;
}

.result-header h3 {
  font-size: 16px;
}

.result-icon {
  font-size: 18px;
}

.copy-all {
  border: 1px solid var(--border);

  background: rgba(79, 140, 255, 0.07);

  color: #8db7ff;

  border-radius: 8px;

  padding: 6px 10px;

  cursor: pointer;

  font-size: 11px;
}

.copy-all:hover {
  background: rgba(79, 140, 255, 0.14);
}

.result-item {
  padding: 12px;

  margin: 7px 0;

  border-radius: 9px;

  background: rgba(5, 9, 22, 0.65);

  border: 1px solid rgba(130, 150, 210, 0.1);

  color: #cbd5e9;

  font-size: 13px;
}

.description-box {
  white-space: pre-wrap;

  background: rgba(5, 9, 22, 0.65);

  border: 1px solid rgba(130, 150, 210, 0.1);

  border-radius: 10px;

  padding: 17px;

  color: #cbd5e9;

  font-size: 13px;
}

.tag-container {
  display: flex;

  flex-wrap: wrap;

  gap: 7px;
}

.tag {
  background: rgba(79, 140, 255, 0.08);

  border: 1px solid rgba(79, 140, 255, 0.16);

  color: #8db7ff;

  border-radius: 999px;

  padding: 6px 9px;

  font-size: 11px;
}

/* =========================
   FEATURES
========================= */

.feature-grid {
  display: grid;

  grid-template-columns: repeat(4, 1fr);

  gap: 15px;
}

.feature {
  padding: 24px;

  transition: 0.25s;
}

.feature:hover {
  transform: translateY(-5px);

  border-color: rgba(79, 140, 255, 0.25);
}

.feature > div {
  font-size: 25px;

  margin-bottom: 15px;
}

.feature h3 {
  margin-bottom: 7px;
}

.feature p {
  color: var(--muted);

  font-size: 13px;
}

/* =========================
   ABOUT
========================= */

.about-card {
  padding: 55px;

  text-align: center;
}

.about-card h2 {
  font-size: 40px;

  margin: 10px 0;
}

.about-card h2 span {
  background:
    linear-gradient(
      90deg,
      var(--blue),
      var(--purple)
    );

  -webkit-background-clip: text;

  color: transparent;
}

.about-card p {
  max-width: 650px;

  margin: auto;

  color: var(--muted);
}

.about-card a {
  display: inline-block;

  margin-top: 25px;

  color: #8db7ff;

  font-weight: 700;
}

/* =========================
   FOOTER
========================= */

footer {
  border-top: 1px solid var(--border);

  padding: 35px 5%;

  text-align: center;

  color: #59647e;

  font-size: 12px;
}

.footer-logo {
  color: white;

  font-size: 18px;

  font-weight: 800;

  margin-bottom: 5px;
}

/* =========================
   TOAST
========================= */

.toast {
  position: fixed;

  bottom: 25px;

  left: 50%;

  transform: translate(-50%, 100px);

  background: #f8fafc;

  color: #101525;

  padding: 10px 18px;

  border-radius: 10px;

  font-size: 13px;

  opacity: 0;

  transition: 0.3s;

  box-shadow:
    0 10px 30px rgba(0, 0, 0, 0.3);
}

.toast.show {
  transform: translate(-50%, 0);

  opacity: 1;
}

/* =========================
   LIGHT MODE
========================= */

body.light {
  --bg: #f4f7fc;
  --bg2: #eef2fa;
  --card: rgba(255, 255, 255, 0.9);
  --text: #111827;
  --muted: #64748b;
  --border: rgba(15, 23, 42, 0.1);
  --shadow: rgba(15, 23, 42, 0.08);

  background:
    radial-gradient(
      circle at 15% 10%,
      rgba(79, 140, 255, 0.12),
      transparent 30%
    ),
    linear-gradient(
      135deg,
      #f8faff,
      #edf2fa
    );
}

body.light .navbar {
  border-color: var(--border);
}

body.light nav {
  color: #64748b;
}

body.light .generator-card,
body.light .result-card,
body.light .feature,
body.light .about-card {
  background: rgba(255, 255, 255, 0.82);

  border-color: var(--border);
}

body.light input,
body.light select,
body.light .result-item,
body.light .description-box {
  background: #f8fafc;

  color: #111827;

  border-color: #dbe2ef;
}

body.light .icon-btn {
  background: white;

  color: #111827;
}

/* =========================
   MOBILE
========================= */

@media (max-width: 750px) {

  nav {
    display: none;
  }

  .hero {
    padding-top: 65px;
  }

  .hero h1 {
    letter-spacing: -2px;
  }

  .hero-stats {
    gap: 25px;
  }

  .form-grid,
  .results-grid {
    grid-template-columns: 1fr;
  }

  .result-card.wide {
    grid-column: span 1;
  }

  .feature-grid {
    grid-template-columns: 1fr 1fr;
  }

  .about-card {
    padding: 30px 20px;
  }

  .about-card h2 {
    font-size: 30px;
  }
}

@media (max-width: 480px) {

  .hero-stats {
    flex-direction: column;

    gap: 15px;
  }

  .feature-grid {
    grid-template-columns: 1fr;
  }

  .generator-card {
    padding: 20px;
  }

  .hero h1 {
    font-size: 43px;
  }
}
