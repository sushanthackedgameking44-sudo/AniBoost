* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

:root {
  --bg: #09090d;
  --card: #12121a;
  --card2: #181822;
  --text: #f5f5f7;
  --muted: #9b9ba8;
  --border: #292936;
  --accent: #8b5cf6;
  --accent2: #6d28d9;
  --danger: #ef4444;
}

body.light {
  --bg: #f5f5f7;
  --card: #ffffff;
  --card2: #eeeeF3;
  --text: #15151a;
  --muted: #666673;
  --border: #ddddE5;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: Arial, sans-serif;
  background: var(--bg);
  color: var(--text);
  line-height: 1.6;
  transition: 0.25s;
}

/* NAVBAR */

.navbar {
  position: sticky;
  top: 0;
  z-index: 100;

  display: flex;
  align-items: center;
  justify-content: space-between;

  height: 70px;
  padding: 0 6%;

  background: rgba(9, 9, 13, 0.9);
  backdrop-filter: blur(15px);

  border-bottom: 1px solid var(--border);
}

body.light .navbar {
  background: rgba(245, 245, 247, 0.9);
}

.logo {
  text-decoration: none;
  color: var(--text);
  font-size: 22px;
  font-weight: 800;
}

.navbar nav {
  display: flex;
  gap: 28px;
}

.navbar nav a {
  color: var(--muted);
  text-decoration: none;
  font-size: 14px;
}

.navbar nav a:hover {
  color: var(--text);
}

.theme-btn {
  border: 1px solid var(--border);
  background: var(--card);
  color: var(--text);

  width: 40px;
  height: 40px;

  border-radius: 10px;
  cursor: pointer;

  font-size: 17px;
}


/* HERO */

.hero {
  max-width: 950px;
  margin: auto;
  padding: 110px 20px 100px;
  text-align: center;
}

.hero-badge {
  display: inline-block;

  padding: 7px 14px;
  margin-bottom: 22px;

  border: 1px solid var(--border);
  border-radius: 50px;

  color: #b9a2ff;
  background: rgba(139, 92, 246, 0.1);

  font-size: 12px;
  font-weight: 700;
  letter-spacing: 1px;
}

.hero h1 {
  font-size: clamp(42px, 7vw, 76px);
  line-height: 1.05;
  letter-spacing: -3px;
  margin-bottom: 25px;
}

.hero h1 span {
  color: var(--accent);
}

.hero p {
  max-width: 650px;
  margin: auto;
  color: var(--muted);
  font-size: 18px;
}

.hero-btn {
  display: inline-block;

  margin-top: 32px;
  padding: 14px 25px;

  color: white;
  text-decoration: none;

  background: var(--accent);
  border-radius: 12px;

  font-weight: 700;
}

.hero-btn:hover {
  background: var(--accent2);
}


/* SECTIONS */

.generator-section,
.tools-section,
.about-section,
.info-section {
  width: min(1100px, 92%);
  margin: auto;
}

.generator-section {
  padding: 50px 0 100px;
}

.tools-section {
  padding: 80px 0;
}

.about-section {
  padding: 70px 0;
}

.info-section {
  padding: 30px 0;
  border-top: 1px solid var(--border);
}

.section-heading {
  display: flex;
  align-items: flex-start;
  gap: 18px;
  margin-bottom: 30px;
}

.section-heading > span {
  color: var(--accent);
  font-weight: 800;
  font-size: 13px;
}

.section-heading h2 {
  font-size: 30px;
  line-height: 1.2;
}

.section-heading p {
  color: var(--muted);
  margin-top: 5px;
}


/* GENERATOR */

.generator-card {
  background: var(--card);
  border: 1px solid var(--border);

  padding: 30px;
  border-radius: 20px;

  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.15);
}

.form-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
}

.input-group {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.input-group label {
  font-size: 13px;
  font-weight: 700;
  color: var(--muted);
}

.input-group input,
.input-group select {
  width: 100%;

  padding: 14px 15px;

  background: var(--card2);
  color: var(--text);

  border: 1px solid var(--border);
  border-radius: 10px;

  outline: none;
  font-size: 15px;
}

.input-group input:focus,
.input-group select:focus {
  border-color: var(--accent);
}

.generate-btn {
  width: 100%;

  margin-top: 25px;
  padding: 15px;

  border: none;
  border-radius: 11px;

  background: var(--accent);
  color: white;

  font-size: 15px;
  font-weight: 800;

  cursor: pointer;
}

.generate-btn:hover {
  background: var(--accent2);
}

.error {
  color: var(--danger);
  margin-top: 12px;
  font-size: 13px;
  text-align: center;
}


/* RESULTS */

.results {
  margin-top: 30px;
  display: grid;
  gap: 18px;
}

.hidden {
  display: none;
}

.result-card {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 18px;
  padding: 22px;
}

.result-header {
  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 15px;
  margin-bottom: 15px;
}

.result-header h3 {
  font-size: 17px;
}

.copy-all {
  border: 1px solid var(--border);
  background: var(--card2);
  color: var(--text);

  padding: 7px 12px;
  border-radius: 8px;

  cursor: pointer;
  font-size: 12px;
}

.result-content {
  display: grid;
  gap: 10px;
}

.result-item {
  padding: 13px 15px;

  background: var(--card2);
  border: 1px solid var(--border);

  border-radius: 10px;
}

.description {
  white-space: pre-line;
  line-height: 1.7;
}

.tag-container {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.tag {
  padding: 7px 11px;

  background: rgba(139, 92, 246, 0.1);
  border: 1px solid rgba(139, 92, 246, 0.25);

  color: #b9a2ff;

  border-radius: 8px;
  font-size: 13px;
}


/* TOOLS */

.tools-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 15px;
}

.tool-card {
  background: var(--card);

  border: 1px solid var(--border);
  border-radius: 16px;

  padding: 25px;
  transition: 0.2s;
}

.tool-card:hover,
.tool-card.active {
  border-color: var(--accent);
  transform: translateY(-3px);
}

.tool-icon {
  font-size: 28px;
  margin-bottom: 18px;
}

.tool-card h3 {
  margin-bottom: 6px;
}

.tool-card p {
  color: var(--muted);
  font-size: 13px;
}


/* ABOUT */

.about-card {
  background: var(--card);

  border: 1px solid var(--border);
  border-radius: 18px;

  padding: 28px;

  color: var(--muted);
}

.about-card p + p {
  margin-top: 15px;
}

.info-section h2 {
  margin-bottom: 10px;
}

.info-section p {
  color: var(--muted);
}


/* FOOTER */

footer {
  margin-top: 80px;
  padding: 50px 20px;

  border-top: 1px solid var(--border);

  text-align: center;
}

.footer-logo {
  font-size: 22px;
  font-weight: 800;
}

footer > p {
  color: var(--muted);
  margin-top: 7px;
}

.footer-links {
  display: flex;
  justify-content: center;
  gap: 20px;
  margin-top: 20px;
}

.footer-links a {
  color: var(--muted);
  text-decoration: none;
  font-size: 13px;
}

.copyright {
  margin-top: 25px !important;
  font-size: 12px;
}


/* TOAST */

.toast {
  position: fixed;

  left: 50%;
  bottom: 25px;

  transform: translate(-50%, 100px);

  background: var(--text);
  color: var(--bg);

  padding: 10px 18px;

  border-radius: 10px;

  font-size: 13px;
  font-weight: 700;

  opacity: 0;

  transition: 0.3s;

  z-index: 500;
}

.toast.show {
  transform: translate(-50%, 0);
  opacity: 1;
}


/* MOBILE */

@media (max-width: 800px) {

  .navbar {
    padding: 0 4%;
  }

  .navbar nav {
    display: none;
  }

  .hero {
    padding: 80px 18px;
  }

  .hero h1 {
    letter-spacing: -2px;
  }

  .hero p {
    font-size: 16px;
  }

  .form-grid {
    grid-template-columns: 1fr;
  }

  .generator-card {
    padding: 20px;
  }

  .tools-grid {
    grid-template-columns: 1fr 1fr;
  }

}

@media (max-width: 500px) {

  .tools-grid {
    grid-template-columns: 1fr;
  }

  .section-heading h2 {
    font-size: 25px;
  }

  .result-card {
    padding: 17px;
  }

  .hero {
    padding-top: 65px;
  }

}