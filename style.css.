@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: Inter, Arial, sans-serif;
  background: #080611;
  color: #f7f4ff;
  line-height: 1.6;
  min-height: 100vh;
}

body::before {
  content: "";
  position: fixed;
  width: 600px;
  height: 600px;
  background: #7c3aed;
  opacity: .08;
  filter: blur(120px);
  border-radius: 50%;
  top: -250px;
  left: -200px;
  pointer-events: none;
  z-index: -1;
}

a {
  color: inherit;
  text-decoration: none;
}

button,
input,
select {
  font: inherit;
}

.navbar {
  width: min(1150px, 92%);
  margin: auto;
  height: 76px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid rgba(255,255,255,.07);
}

.logo {
  font-size: 22px;
  font-weight: 800;
  letter-spacing: -1px;
}

.logo span:last-child {
  color: #a855f7;
}

.logo-icon {
  color: #c084fc;
  margin-right: 5px;
}

nav {
  display: flex;
  gap: 32px;
  color: #a9a3b8;
  font-size: 14px;
}

nav a {
  transition: .2s;
}

nav a:hover {
  color: #fff;
}

.icon-btn {
  border: 1px solid #2a2538;
  background: #11101a;
  color: white;
  border-radius: 10px;
  padding: 9px 11px;
  cursor: pointer;
}

.hero {
  width: min(900px, 92%);
  margin: auto;
  text-align: center;
  padding: 100px 0 80px;
}

.badge {
  display: inline-block;
  padding: 8px 14px;
  border: 1px solid #35234d;
  background: #171022;
  border-radius: 999px;
  color: #c084fc;
  font-size: 12px;
  font-weight: 700;
  margin-bottom: 25px;
}

.hero h1 {
  font-size: clamp(42px, 7vw, 76px);
  line-height: 1.05;
  letter-spacing: -4px;
}

.hero h1 span,
.section-heading span,
.about-card span {
  color: #a855f7;
}

.hero-text {
  max-width: 650px;
  margin: 25px auto;
  color: #a9a3b8;
  font-size: 17px;
}

.hero-btn {
  display: inline-block;
  background: linear-gradient(135deg, #9333ea, #7c3aed);
  padding: 14px 25px;
  border-radius: 12px;
  font-weight: 700;
  box-shadow: 0 10px 35px rgba(124,58,237,.25);
  transition: .2s;
}

.hero-btn:hover,
.generate-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 15px 40px rgba(124,58,237,.35);
}

.hero-stats {
  margin: 55px auto 0;
  display: flex;
  justify-content: center;
  gap: 60px;
}

.hero-stats div {
  display: flex;
  flex-direction: column;
}

.hero-stats strong {
  font-size: 24px;
}

.hero-stats small {
  color: #777184;
  font-size: 12px;
}

.generator-section,
.results,
.features-section,
.about-section {
  width: min(1100px, 92%);
  margin: auto;
  padding: 80px 0;
}

.section-heading {
  text-align: center;
  margin-bottom: 35px;
}

.section-heading span,
.about-card span {
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 2px;
}

.section-heading h2 {
  font-size: clamp(28px, 5vw, 42px);
  margin: 8px 0;
}

.section-heading p {
  color: #817b8e;
}

.generator-card,
.result-card,
.feature,
.about-card {
  border: 1px solid #272233;
  background: rgba(17,15,27,.82);
  border-radius: 18px;
  backdrop-filter: blur(15px);
}

.generator-card {
  padding: 30px;
  max-width: 900px;
  margin: auto;
}

.form-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
}

.input-group label {
  display: block;
  font-size: 13px;
  font-weight: 600;
  margin-bottom: 8px;
  color: #c6c0d0;
}

input,
select {
  width: 100%;
  padding: 14px;
  border: 1px solid #302a3d;
  border-radius: 11px;
  outline: none;
  background: #0d0b14;
  color: white;
}

input:focus,
select:focus {
  border-color: #9333ea;
  box-shadow: 0 0 0 3px rgba(147,51,234,.12);
}

.generate-btn {
  width: 100%;
  margin-top: 24px;
  border: none;
  border-radius: 12px;
  padding: 15px;
  color: white;
  background: linear-gradient(135deg, #9333ea, #7c3aed);
  font-weight: 800;
  cursor: pointer;
  transition: .2s;
}

.privacy-note {
  text-align: center;
  color: #666073;
  font-size: 11px;
  margin-top: 12px;
}

.error {
  color: #fb7185;
  text-align: center;
  margin-top: 15px;
}

.hidden {
  display: none;
}

.results-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18px;
}

.result-card {
  padding: 22px;
}

.result-card.wide {
  grid-column: span 2;
}

.result-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 17px;
}

.result-header div {
  display: flex;
  align-items: center;
  gap: 9px;
}

.result-header h3 {
  font-size: 16px;
}

.result-icon {
  font-size: 18px;
}

.copy-all {
  border: 1px solid #332b42;
  background: #171320;
  color: #c084fc;
  border-radius: 8px;
  padding: 6px 10px;
  cursor: pointer;
  font-size: 11px;
}

.result-item {
  padding: 12px;
  margin: 7px 0;
  border-radius: 9px;
  background: #0d0b14;
  border: 1px solid #211c2c;
  color: #d5cfdf;
  font-size: 13px;
}

.description-box {
  white-space: pre-wrap;
  background: #0d0b14;
  border: 1px solid #211c2c;
  border-radius: 10px;
  padding: 17px;
  color: #c8c1d1;
  font-size: 13px;
}

.tag-container {
  display: flex;
  flex-wrap: wrap;
  gap: 7px;
}

.tag {
  background: #181223;
  border: 1px solid #302143;
  color: #c084fc;
  border-radius: 999px;
  padding: 6px 9px;
  font-size: 11px;
}

.feature-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 15px;
}

.feature {
  padding: 24px;
}

.feature > div {
  font-size: 25px;
  margin-bottom: 15px;
}

.feature h3 {
  margin-bottom: 7px;
}

.feature p {
  color: #817b8e;
  font-size: 13px;
}

.about-card {
  padding: 50px;
  text-align: center;
}

.about-card h2 {
  font-size: 40px;
  margin: 10px 0;
}

.about-card h2 span {
  color: #a855f7;
}

.about-card p {
  max-width: 650px;
  margin: auto;
  color: #817b8e;
}

.about-card a {
  display: inline-block;
  margin-top: 25px;
  color: #c084fc;
  font-weight: 700;
}

footer {
  border-top: 1px solid #201b2b;
  padding: 35px 5%;
  text-align: center;
  color: #676171;
  font-size: 12px;
}

.footer-logo {
  color: white;
  font-size: 18px;
  font-weight: 800;
  margin-bottom: 5px;
}

.toast {
  position: fixed;
  bottom: 25px;
  left: 50%;
  transform: translate(-50%, 100px);
  background: #fff;
  color: #111;
  padding: 10px 18px;
  border-radius: 10px;
  font-size: 13px;
  opacity: 0;
  transition: .3s;
}

.toast.show {
  transform: translate(-50%, 0);
  opacity: 1;
}

body.light {
  background: #f7f5fa;
  color: #17131f;
}

body.light .navbar {
  border-color: #ddd7e5;
}

body.light nav {
  color: #6b6473;
}

body.light .generator-card,
body.light .result-card,
body.light .feature,
body.light .about-card {
  background: white;
  border-color: #e1dce7;
}

body.light input,
body.light select,
body.light .result-item,
body.light .description-box {
  background: #f7f5fa;
  color: #17131f;
  border-color: #ded8e5;
}

body.light .icon-btn {
  background: white;
  color: #222;
}

@media (max-width: 750px) {

  nav {
    display: none;
  }

  .hero {
    padding-top: 65px;
  }

  .hero h1 {
    letter-spacing: -2px;
  }

  .hero-stats {
    gap: 25px;
  }

  .form-grid,
  .results-grid {
    grid-template-columns: 1fr;
  }

  .result-card.wide {
    grid-column: span 1;
  }

  .feature-grid {
    grid-template-columns: 1fr 1fr;
  }

  .about-card {
    padding: 30px 20px;
  }

  .about-card h2 {
    font-size: 30px;
  }
}

@media (max-width: 480px) {

  .hero-stats {
    flex-direction: column;
    gap: 15px;
  }

  .feature-grid {
    grid-template-columns: 1fr;
  }

  .generator-card {
    padding: 20px;
  }
}}

/* NAVBAR */

.navbar {
  position: sticky;
  top: 0;
  z-index: 100;

  display: flex;
  align-items: center;
  justify-content: space-between;

  height: 70px;
  padding: 0 6%;

  background: rgba(9, 9, 13, 0.9);
  backdrop-filter: blur(15px);

  border-bottom: 1px solid var(--border);
}

body.light .navbar {
  background: rgba(245, 245, 247, 0.9);
}

.logo {
  text-decoration: none;
  color: var(--text);
  font-size: 22px;
  font-weight: 800;
}

.navbar nav {
  display: flex;
  gap: 28px;
}

.navbar nav a {
  color: var(--muted);
  text-decoration: none;
  font-size: 14px;
}

.navbar nav a:hover {
  color: var(--text);
}

.theme-btn {
  border: 1px solid var(--border);
  background: var(--card);
  color: var(--text);

  width: 40px;
  height: 40px;

  border-radius: 10px;
  cursor: pointer;

  font-size: 17px;
}


/* HERO */

.hero {
  max-width: 950px;
  margin: auto;
  padding: 110px 20px 100px;
  text-align: center;
}

.hero-badge {
  display: inline-block;

  padding: 7px 14px;
  margin-bottom: 22px;

  border: 1px solid var(--border);
  border-radius: 50px;

  color: #b9a2ff;
  background: rgba(139, 92, 246, 0.1);

  font-size: 12px;
  font-weight: 700;
  letter-spacing: 1px;
}

.hero h1 {
  font-size: clamp(42px, 7vw, 76px);
  line-height: 1.05;
  letter-spacing: -3px;
  margin-bottom: 25px;
}

.hero h1 span {
  color: var(--accent);
}

.hero p {
  max-width: 650px;
  margin: auto;
  color: var(--muted);
  font-size: 18px;
}

.hero-btn {
  display: inline-block;

  margin-top: 32px;
  padding: 14px 25px;

  color: white;
  text-decoration: none;

  background: var(--accent);
  border-radius: 12px;

  font-weight: 700;
}

.hero-btn:hover {
  background: var(--accent2);
}


/* SECTIONS */

.generator-section,
.tools-section,
.about-section,
.info-section {
  width: min(1100px, 92%);
  margin: auto;
}

.generator-section {
  padding: 50px 0 100px;
}

.tools-section {
  padding: 80px 0;
}

.about-section {
  padding: 70px 0;
}

.info-section {
  padding: 30px 0;
  border-top: 1px solid var(--border);
}

.section-heading {
  display: flex;
  align-items: flex-start;
  gap: 18px;
  margin-bottom: 30px;
}

.section-heading > span {
  color: var(--accent);
  font-weight: 800;
  font-size: 13px;
}

.section-heading h2 {
  font-size: 30px;
  line-height: 1.2;
}

.section-heading p {
  color: var(--muted);
  margin-top: 5px;
}


/* GENERATOR */

.generator-card {
  background: var(--card);
  border: 1px solid var(--border);

  padding: 30px;
  border-radius: 20px;

  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.15);
}

.form-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
}

.input-group {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.input-group label {
  font-size: 13px;
  font-weight: 700;
  color: var(--muted);
}

.input-group input,
.input-group select {
  width: 100%;

  padding: 14px 15px;

  background: var(--card2);
  color: var(--text);

  border: 1px solid var(--border);
  border-radius: 10px;

  outline: none;
  font-size: 15px;
}

.input-group input:focus,
.input-group select:focus {
  border-color: var(--accent);
}

.generate-btn {
  width: 100%;

  margin-top: 25px;
  padding: 15px;

  border: none;
  border-radius: 11px;

  background: var(--accent);
  color: white;

  font-size: 15px;
  font-weight: 800;

  cursor: pointer;
}

.generate-btn:hover {
  background: var(--accent2);
}

.error {
  color: var(--danger);
  margin-top: 12px;
  font-size: 13px;
  text-align: center;
}


/* RESULTS */

.results {
  margin-top: 30px;
  display: grid;
  gap: 18px;
}

.hidden {
  display: none;
}

.result-card {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 18px;
  padding: 22px;
}

.result-header {
  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 15px;
  margin-bottom: 15px;
}

.result-header h3 {
  font-size: 17px;
}

.copy-all {
  border: 1px solid var(--border);
  background: var(--card2);
  color: var(--text);

  padding: 7px 12px;
  border-radius: 8px;

  cursor: pointer;
  font-size: 12px;
}

.result-content {
  display: grid;
  gap: 10px;
}

.result-item {
  padding: 13px 15px;

  background: var(--card2);
  border: 1px solid var(--border);

  border-radius: 10px;
}

.description {
  white-space: pre-line;
  line-height: 1.7;
}

.tag-container {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.tag {
  padding: 7px 11px;

  background: rgba(139, 92, 246, 0.1);
  border: 1px solid rgba(139, 92, 246, 0.25);

  color: #b9a2ff;

  border-radius: 8px;
  font-size: 13px;
}


/* TOOLS */

.tools-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 15px;
}

.tool-card {
  background: var(--card);

  border: 1px solid var(--border);
  border-radius: 16px;

  padding: 25px;
  transition: 0.2s;
}

.tool-card:hover,
.tool-card.active {
  border-color: var(--accent);
  transform: translateY(-3px);
}

.tool-icon {
  font-size: 28px;
  margin-bottom: 18px;
}

.tool-card h3 {
  margin-bottom: 6px;
}

.tool-card p {
  color: var(--muted);
  font-size: 13px;
}


/* ABOUT */

.about-card {
  background: var(--card);

  border: 1px solid var(--border);
  border-radius: 18px;

  padding: 28px;

  color: var(--muted);
}

.about-card p + p {
  margin-top: 15px;
}

.info-section h2 {
  margin-bottom: 10px;
}

.info-section p {
  color: var(--muted);
}


/* FOOTER */

footer {
  margin-top: 80px;
  padding: 50px 20px;

  border-top: 1px solid var(--border);

  text-align: center;
}

.footer-logo {
  font-size: 22px;
  font-weight: 800;
}

footer > p {
  color: var(--muted);
  margin-top: 7px;
}

.footer-links {
  display: flex;
  justify-content: center;
  gap: 20px;
  margin-top: 20px;
}

.footer-links a {
  color: var(--muted);
  text-decoration: none;
  font-size: 13px;
}

.copyright {
  margin-top: 25px !important;
  font-size: 12px;
}


/* TOAST */

.toast {
  position: fixed;

  left: 50%;
  bottom: 25px;

  transform: translate(-50%, 100px);

  background: var(--text);
  color: var(--bg);

  padding: 10px 18px;

  border-radius: 10px;

  font-size: 13px;
  font-weight: 700;

  opacity: 0;

  transition: 0.3s;

  z-index: 500;
}

.toast.show {
  transform: translate(-50%, 0);
  opacity: 1;
}


/* MOBILE */

@media (max-width: 800px) {

  .navbar {
    padding: 0 4%;
  }

  .navbar nav {
    display: none;
  }

  .hero {
    padding: 80px 18px;
  }

  .hero h1 {
    letter-spacing: -2px;
  }

  .hero p {
    font-size: 16px;
  }

  .form-grid {
    grid-template-columns: 1fr;
  }

  .generator-card {
    padding: 20px;
  }

  .tools-grid {
    grid-template-columns: 1fr 1fr;
  }

}

@media (max-width: 500px) {

  .tools-grid {
    grid-template-columns: 1fr;
  }

  .section-heading h2 {
    font-size: 25px;
  }

  .result-card {
    padding: 17px;
  }

  .hero {
    padding-top: 65px;
  }

}
